digraph "13_components" {
	bgcolor=white fontname=Lato fontsize=14 nodesep=0.28 pad=0.16 rankdir=TB ranksep=0.34 splines=polyline
	node [color="#A6B8C4" fillcolor="#F3F5F7" fontcolor="#18344B" fontname=Lato fontsize=14 margin="0.16,0.12" penwidth=1.1 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#5D7687" fontcolor="#18344B" fontname=Lato fontsize=11]
	web [label="Browser: research UI and source viewer" color="#18344B" fillcolor="#18344B" fontcolor=white]
	api [label="API: identity, permissions, catalog and research"]
	worker [label="Workers: ingestion, indexing, research and exports"]
	pg [label="PostgreSQL
Canonical records
Permissions / jobs / graph" fillcolor="#EDF5F7" shape=cylinder]
	os [label="OpenSearch
Rebuildable indexes
Public / private separation" fillcolor="#EDF5F7" shape=cylinder]
	s3 [label="Object storage
Original files
Extracts / manifests" fillcolor="#EDF5F7" shape=cylinder]
	queue [label="Outbox + work queues
Durable job notifications"]
	model [label="Approved model gateway
Generation / embeddings / reranking" color="#167D8D" fillcolor="#EDF5F7"]
	web -> api
	api -> pg
	api -> os
	api -> s3
	api -> queue
	queue -> worker
	worker -> pg
	worker -> os
	worker -> s3
	worker -> model
	pg -> s3 [style=invis weight=10]
}
