digraph "14_aws" {
	bgcolor=white fontname=Lato fontsize=14 nodesep=0.28 pad=0.16 rankdir=TB ranksep=0.34 splines=polyline
	node [color="#A6B8C4" fillcolor="#F3F5F7" fontcolor="#18344B" fontname=Lato fontsize=14 margin="0.16,0.12" penwidth=1.1 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#5D7687" fontcolor="#18344B" fontname=Lato fontsize=11]
	user [label="Authenticated user" color="#18344B" fillcolor="#18344B" fontcolor=white]
	"edge" [label="Route 53 → HTTPS load balancer
Certificate + WAF + request limits"]
	compute [label="Private ECS Fargate services
Web / API / separate worker roles"]
	data [label="Private data services
RDS PostgreSQL + OpenSearch" fillcolor="#EDF5F7" shape=cylinder]
	storage [label="S3 + KMS
Quarantine / corpus / private / exports" fillcolor="#EDF5F7" shape=cylinder]
	work [label="SQS + dead-letter queues
EventBridge scheduled discovery"]
	model [label="Approved provider route only
Data-class and processing-region policy" color="#167D8D" fillcolor="#EDF5F7"]
	ops [label="Secrets Manager • CloudWatch • audit
Backups • controlled CI/CD • restore tests"]
	user -> "edge"
	"edge" -> compute
	compute -> data
	compute -> storage
	compute -> work
	compute -> model
	ops -> compute [label="operate / observe" style=dashed]
	{
		rank=same
		data
		storage
	}
	{
		rank=same
		work
		model
	}
	data -> work [style=invis weight=10]
}
