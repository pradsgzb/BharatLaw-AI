digraph "15_release" {
	bgcolor=white fontname=Lato fontsize=14 nodesep=0.28 pad=0.16 rankdir=TB ranksep=0.34 splines=polyline
	node [color="#A6B8C4" fillcolor="#F3F5F7" fontcolor="#18344B" fontname=Lato fontsize=14 margin="0.16,0.12" penwidth=1.1 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#5D7687" fontcolor="#18344B" fontname=Lato fontsize=11]
	a [label="Editor receives correction or new source" color="#18344B" fillcolor="#18344B" fontcolor=white]
	b [label="New artifact / extraction / legal-unit version
Old released evidence stays immutable"]
	c [label="Candidate release: new indexes and snapshots"]
	d [label="Rights + legal + integrity + retrieval checks" color="#BA872C" fillcolor="#FFF1D5"]
	e [label="Publish new release pointer
New runs use the new release" color="#167D8D" fillcolor="#EDF5F7"]
	f [label="Old runs retain their original evidence
Current access restrictions still apply"]
	x [label="Failed candidate remains unpublished
Rollback only to an eligible safe release" color="#B6584B" fillcolor="#FBE9E7"]
	a -> b
	b -> c
	c -> d
	d -> e [label=Pass]
	d -> x [label=Fail]
	e -> f
}
