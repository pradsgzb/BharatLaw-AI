digraph "05_verification" {
	bgcolor=white fontname=Lato fontsize=14 nodesep=0.28 pad=0.16 rankdir=TB ranksep=0.34 splines=polyline
	node [color="#A6B8C4" fillcolor="#F3F5F7" fontcolor="#18344B" fontname=Lato fontsize=14 margin="0.16,0.12" penwidth=1.1 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#5D7687" fontcolor="#18344B" fontname=Lato fontsize=11]
	a [label="Draft claim with evidence handle E1" color="#18344B" fillcolor="#18344B" fontcolor=white]
	b [label="1. Deterministic integrity
Run / release / access / exact quote / hash"]
	c [label="2. Semantic support
Does the passage support the claim
and preserve relevant qualifications?"]
	d [label="3. Review policy
Is qualified human review required?" color="#BA872C" fillcolor="#FFF1D5"]
	e [label="Publish only eligible claims
Display actual review status" color="#167D8D" fillcolor="#EDF5F7"]
	r [label="At most one bounded repair
Then omit, qualify or abstain" color="#B6584B" fillcolor="#FBE9E7"]
	h [label="Authorized human review
Record decision and rationale" color="#BA872C" fillcolor="#FFF1D5"]
	a -> b
	b -> c
	c -> d
	b -> r [label=Fail]
	c -> r [label="Fail / unsupported"]
	d -> e [label="Not required"]
	d -> h [label=Required]
	h -> e [label=Approved]
