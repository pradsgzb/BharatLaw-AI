digraph "02_research" {
	bgcolor=white fontname=Lato fontsize=14 nodesep=0.28 pad=0.16 rankdir=TB ranksep=0.34 splines=polyline
	node [color="#A6B8C4" fillcolor="#F3F5F7" fontcolor="#18344B" fontname=Lato fontsize=14 margin="0.16,0.12" penwidth=1.1 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#5D7687" fontcolor="#18344B" fontname=Lato fontsize=11]
	a [label="User submits question, workspace and dates" color="#18344B" fillcolor="#18344B" fontcolor=white]
	b [label="Authorize access • reserve budget
Pin corpus, model and policy versions"]
	c [label="Is material information
missing?" fillcolor="#FFF1D5" margin="0.09,0.06" shape=diamond]
	d [label="Ask up to two clarification rounds
Save any accepted assumptions" color="#BA872C" fillcolor="#FFF1D5"]
	e [label="Retrieve legislation, cases and contrary material
Expand definitions and exceptions"]
	f [label="Build canonical evidence set
Generate structured, evidence-linked claims"]
	g [label="Integrity + support + current-access checks"]
	h [label="Publish supported answer
with scope and limitations" color="#167D8D" fillcolor="#EDF5F7"]
	i [label="Partial answer, review or abstention
Never fill gaps with invented authority" color="#BA872C" fillcolor="#FFF1D5"]
	a -> b
	b -> c
	c -> d [label=Yes]
	d -> e [label="Resolved / assumptions accepted"]
	c -> e [label=No]
	e -> f
	f -> g
	g -> h [label=Pass]
	g -> i [label="Insufficient / unresolved"]
}
